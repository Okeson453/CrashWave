# =============================================================================
# BC.Game Crash Automation — Environment Template
# Copy to .env and fill in real values before starting.
#   cp .env.example .env
# =============================================================================

# --- Required infrastructure -------------------------------------------------
# PostgreSQL connection string (standard Postgres 13+ required; TimescaleDB optional for better time-series performance)
DATABASE_URL=

# Redis URL for distributed locks, idempotency, and caching
REDIS_URL=rediss://default:N9kMWCgTC2bkHvmnzBWR8vH2@crashwave-lit-acre.cloud.layerbase.dev
# Optional Redis key prefix (default: crash:)
# REDIS_KEY_PREFIX=crash:

# 32-byte encryption key (base64). Generate with: npm run generate-key
ENCRYPTION_KEY=

# --- Telegram ----------------------------------------------------------------
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to control the bot (fail-closed if empty)
TELEGRAM_ALLOWED_USER_IDS=
# Operator chat ID for outbound notifications (can be same as a user ID)
TELEGRAM_OPERATOR_CHAT_ID=

# Multi-tenant control plane admin (same bot, elevated privileges)
ADMIN_TELEGRAM_ID=
ADMIN_API_TOKEN=
CONTROL_PLANE_PORT=8081
CONTROL_PLANE_URL=http://127.0.0.1:8081
TENANT_MASTER_KEY=

# --- Application mode --------------------------------------------------------
# observe-only | dry-run | live | maintenance
APP_SYSTEM__MODE=dry-run
APP_SYSTEM__LOG_LEVEL=info
NODE_ENV=development

# --- Browser / Playwright ----------------------------------------------------
BC_GAME_URL=https://bc.game/crash
BROWSER_HEADLESS=false
BROWSER_PROFILE_DIR=./secrets/browser-profile
APP_BROWSER__TIMEOUT_MS=30000

# --- Betting policy (override defaults) -----------------------------------------
APP_BETTING__STAKE_PER_ENTRY=700
APP_BETTING__CASH_OUT_TARGET=1.30
APP_BETTING__MAX_DAILY_ENTRIES=100
APP_BETTING__DAY_BOUNDARY_TIMEZONE=UTC

# --- Risk -------------------------------------------------------------------
APP_RISK__MIN_BALANCE_FOR_ENTRY=700
APP_RISK__BALANCE_BUFFER=700
APP_RISK__MAX_CONSECUTIVE_ERRORS_BEFORE_STOP=3
APP_RISK__MAX_CASH_OUT_FAILURES_BEFORE_STOP=2

# --- Observation -----------------------------------------------------------
APP_OBSERVATION__MIN_CONFIDENCE_FOR_ENTRY=high
APP_OBSERVATION__MAX_TICK_LATENCY_MS=1000

# --- Metrics / observability -------------------------------------------------
METRICS_PORT=9090

# --- Optional Docker / production -------------------------------------------
# Use Docker secrets in production instead of plain env for tokens and keys.
COMPOSE_PROJECT_NAME=crash-automation

# --- Residential / ISP proxy (largest real-world detection lever) -----------
# Enable only with a quality residential/ISP provider. Sticky session required.
APP_PROXY__ENABLED=false
APP_PROXY__SERVER=http://user:pass@host:port
APP_PROXY__USERNAME=
APP_PROXY__PASSWORD=
APP_PROXY__STICKY=true
APP_PROXY__ROTATION_MODE=never
APP_PROXY__PROVIDER=generic

# --- Velocity / behavioral (defaults are already safe) ----------------------
APP_VELOCITY__ENABLED=true
APP_VELOCITY__MIN_ACTION_INTERVAL_MS=8000
APP_BEHAVIORAL__ENABLED=true
APP_TELEMETRY_NOISE__ENABLED=false

# --- Live headless policy ---------------------------------------------------
# Live mode forces headed browser when preferNonHeadlessForLive=true (default).
BROWSER_HEADLESS=false
