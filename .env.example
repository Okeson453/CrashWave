# =============================================================================
# Personal-Use BC Crash Automation — Environment Template
# Copy to .env and fill in real values before starting.
#   cp .env.example .env
# =============================================================================

# --- Application mode --------------------------------------------------------
# observe-only | dry-run | live | maintenance
APP_SYSTEM__MODE=dry-run
APP_SYSTEM__LOG_LEVEL=info
NODE_ENV=production

# --- Telegram (REQUIRED) ----------------------------------------------------
TELEGRAM_BOT_TOKEN=                # from @BotFather
APP_TELEGRAM__ALLOWED_USER_IDS=[123456789]   # your numeric Telegram user ID

# --- Database (REQUIRED) ----------------------------------------------------
DATABASE_URL=postgresql://user:pass@localhost:5432/bc_personal
# REDIS_URL=redis://localhost:6379    # OPTIONAL — only if you want the rate-limit window backed by Redis

# --- Browser (REQUIRED for live mode) ---------------------------------------
BROWSER_HEADLESS=true
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# --- Encryption (REQUIRED for live mode, AES-256-GCM for BC.Game cookie) ---
ENCRYPTION_KEY=                    # 32-byte hex; generate via `npm run generate-key`

# --- Proxy (optional) -------------------------------------------------------
# APP_PROXY__ENABLED=true
# APP_PROXY__SERVER=http://host:port
# APP_PROXY__USERNAME=...
# APP_PROXY__PASSWORD=...

# --- Metrics port (default 9090) -------------------------------------------
METRICS_PORT=9090